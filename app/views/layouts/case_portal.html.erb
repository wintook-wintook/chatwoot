<!DOCTYPE html>
<html lang="<%= @portal&.locale || 'es' %>" class="">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= [@portal&.name, 'Portal de soporte'].compact.join(' · ') %></title>
  <meta name="robots" content="noindex" />
  <%= csrf_meta_tags %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { darkMode: 'class' };
    function toggleDark() { document.documentElement.classList.toggle('dark'); }
  </script>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col">

  <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
    <div class="max-w-3xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href="<%= case_portal_path(@portal.slug) %>" class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold">
          <%= @portal.name.to_s.first&.upcase %>
        </div>
        <div>
          <div class="font-semibold leading-tight"><%= @portal.name %></div>
          <div class="text-xs text-slate-500 dark:text-slate-400">Centro de ayuda</div>
        </div>
      </a>
      <div class="flex items-center gap-2 text-sm">
        <a href="<%= case_portal_status_path(@portal.slug) %>" class="px-3 py-1.5 rounded hover:bg-slate-100 dark:hover:bg-slate-700">Consultar estado</a>
        <button type="button" onclick="toggleDark()" class="px-2 py-1 rounded hover:bg-slate-100 dark:hover:bg-slate-700">🌓</button>
      </div>
    </div>
  </header>

  <main class="flex-1 w-full">
    <%= yield %>
  </main>

  <footer class="border-t border-slate-200 dark:border-slate-700 py-6 text-center text-xs text-slate-400">
    <%= @portal.name %> · Portal de soporte
  </footer>
</body>
</html>
