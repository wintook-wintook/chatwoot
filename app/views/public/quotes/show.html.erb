<% content_for(:title, @quote.folio) %>
<% money = ->(value) { "#{number_to_currency(value, unit: '$', precision: 2)} #{@quote.currency}" } %>
<% status_classes = { 'won' => 'bg-green-100 text-green-800', 'lost' => 'bg-red-100 text-red-800',
                      'cancelled' => 'bg-slate-200 text-slate-700', 'postponed' => 'bg-yellow-100 text-yellow-800' } %>

<% if flash.now[:error] %>
  <div class="p-3 mb-4 text-sm text-red-800 bg-red-100 rounded-lg no-print"><%= flash.now[:error] %></div>
<% end %>

<article class="p-6 bg-white shadow-sm rounded-xl">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="m-0 text-xs font-semibold tracking-wide uppercase text-slate-500"><%= t('public_quotes.title') %></p>
      <h1 class="m-0 text-2xl font-bold"><%= @quote.folio %></h1>
      <p class="m-0 mt-1 text-sm text-slate-600">
        <%= t('public_quotes.for', name: @quote.contact.name) %>
      </p>
    </div>
    <div class="text-sm text-right">
      <% unless @quote.open? %>
        <span class="inline-block px-2 py-1 mb-2 text-xs font-semibold rounded <%= status_classes[@quote.status] %>">
          <%= t("public_quotes.statuses.#{@quote.status}") %>
        </span>
      <% end %>
      <div class="text-slate-600"><%= t('public_quotes.date') %>: <%= @quote.created_at.to_date.strftime('%d/%m/%Y') %></div>
      <% if @quote.valid_until %>
        <div class="<%= @quote.expired? ? 'text-red-600 font-medium' : 'text-slate-600' %>">
          <%= t('public_quotes.valid_until') %>: <%= @quote.valid_until.strftime('%d/%m/%Y') %>
        </div>
      <% end %>
      <% if @quote.assignee %>
        <div class="text-slate-600"><%= t('public_quotes.seller') %>: <%= @quote.assignee.name %></div>
      <% end %>
    </div>
  </div>

  <div class="mt-6 overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left border-b text-slate-500 border-slate-200">
          <th class="py-2 pr-2 font-medium"><%= t('public_quotes.columns.description') %></th>
          <th class="px-2 py-2 font-medium text-right"><%= t('public_quotes.columns.quantity') %></th>
          <th class="px-2 py-2 font-medium text-right"><%= t('public_quotes.columns.price') %></th>
          <th class="px-2 py-2 font-medium text-right"><%= t('public_quotes.columns.discount') %></th>
          <th class="py-2 pl-2 font-medium text-right"><%= t('public_quotes.columns.total') %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @quote.items.each do |item| %>
          <tr>
            <td class="py-2 pr-2"><%= item.description %></td>
            <td class="px-2 py-2 text-right whitespace-nowrap"><%= number_with_precision(item.quantity, precision: 2, strip_insignificant_zeros: true) %> <%= item.unit %></td>
            <td class="px-2 py-2 text-right whitespace-nowrap"><%= money.call(item.unit_price) %></td>
            <td class="px-2 py-2 text-right whitespace-nowrap"><%= item.discount_percent.positive? ? "#{number_with_precision(item.discount_percent, precision: 2, strip_insignificant_zeros: true)}%" : '—' %></td>
            <td class="py-2 pl-2 text-right whitespace-nowrap"><%= money.call(item.total) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <dl class="grid w-full max-w-xs grid-cols-2 gap-1 mt-4 ml-auto text-sm">
    <dt class="text-slate-500"><%= t('public_quotes.subtotal') %></dt><dd class="m-0 text-right"><%= money.call(@quote.subtotal) %></dd>
    <% if @quote.discount_total.positive? %>
      <dt class="text-slate-500"><%= t('public_quotes.discount') %></dt><dd class="m-0 text-right">−<%= money.call(@quote.discount_total) %></dd>
    <% end %>
    <% if @quote.tax_total.positive? %>
      <dt class="text-slate-500"><%= t('public_quotes.tax') %></dt><dd class="m-0 text-right"><%= money.call(@quote.tax_total) %></dd>
    <% end %>
    <dt class="pt-1 font-semibold border-t border-slate-200"><%= t('public_quotes.total') %></dt>
    <dd class="pt-1 m-0 font-semibold text-right border-t border-slate-200"><%= money.call(@quote.total) %></dd>
  </dl>

  <% if @quote.terms.present? %>
    <section class="mt-6">
      <h2 class="mb-1 text-sm font-semibold"><%= t('public_quotes.terms') %></h2>
      <p class="m-0 text-sm whitespace-pre-line text-slate-600"><%= @quote.terms %></p>
    </section>
  <% end %>

  <% if @quote.won? && @quote.accepted_by_name.present? %>
    <section class="pt-4 mt-6 border-t border-slate-200">
      <p class="m-0 text-sm text-green-800">
        <%= t('public_quotes.accepted_by', name: @quote.accepted_by_name, date: @quote.decided_at.strftime('%d/%m/%Y %H:%M')) %>
      </p>
      <% if @quote.accepted_signature.present? %>
        <img src="<%= @quote.accepted_signature %>" alt="<%= t('public_quotes.signature') %>" class="h-20 mt-2" />
      <% end %>
    </section>
  <% end %>
</article>

<% if @quote.open? && @quote.expired? %>
  <div class="p-4 mt-4 text-sm text-yellow-900 bg-yellow-100 rounded-lg no-print">
    <%= t('public_quotes.expired_notice') %>
  </div>
<% elsif @quote.open? %>
  <section class="grid gap-4 mt-4 no-print sm:grid-cols-2">
    <form action="<%= public_quote_accept_path(@quote.public_token) %>" method="post" class="p-4 bg-white shadow-sm rounded-xl" onsubmit="saveSignature()">
      <h2 class="m-0 mb-2 text-base font-semibold"><%= t('public_quotes.accept_title') %></h2>
      <label class="block text-sm text-slate-600"><%= t('public_quotes.your_name') %>
        <input name="accepted_by_name" required class="w-full px-3 py-2 mt-1 border rounded-md border-slate-300" />
      </label>
      <p class="mt-3 mb-1 text-sm text-slate-600"><%= t('public_quotes.sign_here') %></p>
      <%= render 'public/shared/signature_pad' %>
      <div class="flex items-center justify-between mt-3">
        <button type="button" onclick="clearSignature()" class="text-sm text-slate-500"><%= t('public_quotes.clear') %></button>
        <button class="px-4 py-2 text-sm font-semibold text-white bg-green-600 rounded-md hover:bg-green-700"><%= t('public_quotes.accept') %></button>
      </div>
    </form>
    <form action="<%= public_quote_reject_path(@quote.public_token) %>" method="post" class="p-4 bg-white shadow-sm rounded-xl">
      <h2 class="m-0 mb-2 text-base font-semibold"><%= t('public_quotes.reject_title') %></h2>
      <label class="block text-sm text-slate-600"><%= t('public_quotes.comment') %>
        <textarea name="comment" rows="4" class="w-full px-3 py-2 mt-1 border rounded-md border-slate-300"></textarea>
      </label>
      <div class="flex justify-end mt-3">
        <button class="px-4 py-2 text-sm font-semibold border rounded-md text-slate-700 border-slate-300 hover:bg-slate-50"><%= t('public_quotes.reject') %></button>
      </div>
    </form>
  </section>
<% end %>
