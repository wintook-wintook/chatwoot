<% content_for(:title, @order.folio) %>
<% content_for(:hide_print, true) %>
<% contact = @order.contact %>
<% if flash[:error] %>
  <div class="p-3 mb-4 text-sm text-red-800 bg-red-100 rounded-lg"><%= flash[:error] %></div>
<% end %>
<article class="p-5 bg-white shadow-sm rounded-xl">
  <p class="m-0 text-xs font-semibold tracking-wide uppercase text-slate-500"><%= t('field_portal.external.title', name: @order.external_technician['name']) %></p>
  <h1 class="m-0 text-xl font-bold"><%= @order.folio %> · <%= @order.title %></h1>
  <% if @order.description.present? %>
    <p class="mt-2 mb-0 text-sm whitespace-pre-line text-slate-700"><%= @order.description %></p>
  <% end %>
  <dl class="mt-3 space-y-1 text-sm">
    <% if contact %>
      <div><dt class="inline text-slate-500"><%= t('public_reports.customer') %>:</dt> <dd class="inline m-0"><%= contact.name %></dd></div>
    <% end %>
    <% if @order.work_address.present? %>
      <div><dt class="inline text-slate-500"><%= t('public_reports.address') %>:</dt> <dd class="inline m-0"><%= @order.work_address %></dd></div>
    <% end %>
  </dl>
  <div class="grid grid-cols-2 gap-2 mt-4">
    <% if @order.work_address.present? %>
      <a href="https://www.google.com/maps/dir/?api=1&destination=<%= ERB::Util.url_encode(@order.work_address) %>" target="_blank" rel="noopener noreferrer" class="px-3 py-2 text-sm font-semibold text-center border rounded-md border-slate-300"><%= t('field_portal.external.directions') %></a>
    <% end %>
    <% if contact&.phone_number.present? %>
      <a href="tel:<%= contact.phone_number %>" class="px-3 py-2 text-sm font-semibold text-center border rounded-md border-slate-300"><%= t('field_portal.external.call') %></a>
    <% end %>
  </div>
</article>

<% if @entry.nil? %>
  <form action="<%= public_external_visit_arrive_path(params[:token]) %>" method="post" class="mt-4" data-location>
    <input type="hidden" name="lat" /><input type="hidden" name="lng" /><input type="hidden" name="accuracy" />
    <button class="w-full px-4 py-3 text-base font-semibold text-white bg-indigo-600 rounded-xl"><%= t('field_portal.external.arrive') %></button>
  </form>
<% else %>
  <p class="p-3 mt-4 text-sm text-indigo-800 bg-indigo-50 rounded-xl"><%= t('field_portal.external.working', time: @entry.started_at.in_time_zone.strftime('%H:%M')) %></p>

  <section class="p-4 mt-4 bg-white shadow-sm rounded-xl">
    <h2 class="m-0 mb-2 text-base font-semibold"><%= t('public_reports.work_done') %></h2>
    <% @logs.each do |log| %>
      <div class="py-2 text-sm border-t border-slate-100 first:border-t-0">
        <% if log.tag %><span class="px-1.5 mr-1 text-xs rounded bg-slate-100"><%= t("public_reports.tags.#{log.tag}") %></span><% end %>
        <% if log.note? %>
          <span class="whitespace-pre-line"><%= log.content %></span>
        <% elsif log.file.attached? && log.photo? %>
          <img src="<%= url_for(log.file) %>" alt="" class="object-cover w-24 h-24 rounded-md" />
        <% elsif log.file.attached? %>
          <%= log.file.filename %>
        <% end %>
      </div>
    <% end %>
    <form action="<%= public_external_visit_log_path(params[:token]) %>" method="post" enctype="multipart/form-data" class="pt-3 mt-2 space-y-2 border-t border-slate-100">
      <textarea name="content" rows="2" class="w-full px-3 py-2 text-sm border rounded-md border-slate-300" placeholder="<%= t('field_portal.external.note_placeholder') %>"></textarea>
      <div class="flex items-center gap-2 text-sm">
        <input type="file" name="file" accept="image/*" capture="environment" class="flex-1 min-w-0" />
        <select name="tag" class="px-2 py-1 border rounded-md border-slate-300">
          <option value=""></option>
          <option value="before"><%= t('public_reports.tags.before') %></option>
          <option value="after"><%= t('public_reports.tags.after') %></option>
        </select>
      </div>
      <button class="w-full px-4 py-2 text-sm font-semibold border rounded-md border-slate-300"><%= t('field_portal.external.save') %></button>
    </form>
  </section>

  <form action="<%= public_external_visit_finish_path(params[:token]) %>" method="post" class="p-4 mt-4 bg-white shadow-sm rounded-xl" data-location onsubmit="saveSignature()">
    <h2 class="m-0 mb-2 text-base font-semibold"><%= t('field_portal.external.finish_title') %></h2>
    <input type="hidden" name="lat" /><input type="hidden" name="lng" /><input type="hidden" name="accuracy" />
    <label class="block text-sm text-slate-600"><%= t('field_portal.external.received_by') %>
      <input name="received_by" class="w-full px-3 py-2 mt-1 border rounded-md border-slate-300" />
    </label>
    <label class="block mt-2 text-sm text-slate-600"><%= t('field_portal.external.conformity_note') %>
      <textarea name="conformity_note" rows="2" class="w-full px-3 py-2 mt-1 border rounded-md border-slate-300"></textarea>
    </label>
    <p class="mt-3 mb-1 text-sm text-slate-600"><%= t('public_quotes.sign_here') %></p>
    <%= render 'public/shared/signature_pad' %>
    <div class="flex items-center justify-between mt-3">
      <button type="button" onclick="clearSignature()" class="text-sm text-slate-500"><%= t('public_quotes.clear') %></button>
      <button class="px-4 py-2 text-sm font-semibold text-white bg-green-600 rounded-md"><%= t('field_portal.external.finish') %></button>
    </div>
  </form>
<% end %>

<script>
  // Ubicación solo al llegar y al terminar (evidencia, sin rastreo). Sin permiso, se envía sin ella.
  document.querySelectorAll('form[data-location]').forEach(function (form) {
    form.addEventListener('submit', function (event) {
      if (form.dataset.located || !navigator.geolocation) return;
      event.preventDefault();
      var send = function () { form.dataset.located = '1'; if (window.saveSignature && form.querySelector('canvas')) window.saveSignature(); form.submit(); };
      navigator.geolocation.getCurrentPosition(function (pos) {
        form.lat.value = pos.coords.latitude; form.lng.value = pos.coords.longitude; form.accuracy.value = pos.coords.accuracy; send();
      }, send, { timeout: 8000, maximumAge: 60000 });
    });
  });
</script>
