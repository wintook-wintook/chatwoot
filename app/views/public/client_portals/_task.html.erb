<%# Una tarea del cliente o visible (nuestra), con su historial y, si es suya y está abierta, sus acciones. %>
<% day = ->(time) { time&.in_time_zone&.strftime('%d/%m/%Y') } %>
<% task_path = public_client_portal_task_path(params[:token], task.id) %>
  <% mine = task.for_client? %>
  <% state = task.done? ? 'done' : (task.client_status || 'pending') %>
  <% overdue = task.pending? && task.due_at && task.due_at < Time.current %>
  <div id="t<%= task.id %>" class="p-4 mt-3 bg-white border rounded-xl <%= mine && task.pending? ? 'border-indigo-200' : 'border-slate-200' %>">
    <div class="flex items-start gap-2">
      <span class="mt-0.5 inline-flex items-center justify-center w-5 h-5 text-xs rounded-full shrink-0 <%= task.done? ? 'bg-green-100 text-green-700' : (state == 'in_progress' ? 'bg-amber-100 text-amber-700' : 'bg-slate-100 text-slate-500') %>"><%= task.done? ? '✓' : '•' %></span>
      <div class="flex-1 min-w-0">
        <p class="m-0 font-medium <%= task.done? ? 'line-through text-slate-400' : '' %>"><%= task.title %></p>
        <p class="m-0 mt-0.5 text-xs text-slate-500">
          <%= mine ? t("client_portal.states.#{state}") : t("client_portal.our_states.#{task.done? ? 'done' : 'pending'}") %>
          <% if task.due_at && task.pending? %>
            · <span class="<%= overdue ? 'text-red-600 font-semibold' : '' %>"><%= overdue ? t('client_portal.overdue', date: day.call(task.due_at)) : t('client_portal.due', date: day.call(task.due_at)) %></span>
          <% end %>
          <% if mine && task.requires_file && task.pending? %> · <%= t('client_portal.requires_file') %><% end %>
        </p>
        <% if task.done? && task.completed_by_contact %>
          <p class="m-0 mt-0.5 text-xs text-green-700"><%= t('client_portal.done_by', name: task.completed_by_contact.name, date: day.call(task.completed_at)) %></p>
        <% end %>
        <% if task.description.present? && (mine || !task.done?) %>
          <div class="mt-2 text-sm whitespace-pre-line text-slate-700"><%= task.description %></div>
        <% end %>
      </div>
    </div>

    <% entries = task.client_entries.sort_by(&:created_at) %>
    <% if mine && entries.any? %>
      <details class="mt-3 text-sm" <%= 'open' if task.pending? %>>
        <summary class="text-xs font-semibold cursor-pointer text-slate-500"><%= t('client_portal.history') %> (<%= entries.size %>)</summary>
        <ul class="p-0 m-0 mt-2 space-y-2 list-none">
          <% entries.each do |entry| %>
            <li class="p-2 rounded-md <%= entry.by_client? ? 'bg-slate-50' : 'bg-indigo-50' %>">
              <p class="m-0 text-xs text-slate-500"><%= entry.author_name || @account.name %> · <%= t("client_portal.kinds.#{entry.kind}") %> · <%= day.call(entry.created_at) %></p>
              <% if entry.content.present? %><p class="m-0 mt-1 whitespace-pre-line"><%= entry.content %></p><% end %>
              <% if entry.file.attached? %>
                <a class="inline-block mt-1 text-indigo-700 underline" href="<%= rails_blob_path(entry.file, disposition: 'attachment') %>"><%= entry.file.filename %></a>
              <% end %>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>

    <% if mine && task.pending? %>
      <div class="flex flex-wrap gap-2 mt-3">
        <% if task.client_status != 'in_progress' %>
          <form action="<%= task_path %>" method="post">
            <input type="hidden" name="do" value="start" />
            <button class="px-3 py-1.5 text-sm font-semibold border rounded-md border-slate-300 hover:bg-slate-50"><%= t('client_portal.start') %></button>
          </form>
        <% end %>
        <details class="w-full text-sm sm:w-auto">
          <summary class="inline-block px-3 py-1.5 font-semibold text-white bg-green-600 rounded-md cursor-pointer hover:bg-green-700"><%= t('client_portal.finish') %></summary>
          <form action="<%= task_path %>" method="post" class="mt-2">
            <input type="hidden" name="do" value="finish" />
            <textarea name="content" rows="2" class="w-full px-3 py-2 border rounded-md border-slate-300" placeholder="<%= t('client_portal.finish_note') %>"></textarea>
            <button class="px-3 py-1.5 mt-1 text-sm font-semibold text-white bg-green-600 rounded-md"><%= t('client_portal.send') %></button>
          </form>
        </details>
        <details class="w-full text-sm sm:w-auto">
          <summary class="inline-block px-3 py-1.5 font-semibold border rounded-md cursor-pointer border-slate-300 hover:bg-slate-50"><%= t('client_portal.comment') %></summary>
          <form action="<%= task_path %>" method="post" class="mt-2">
            <input type="hidden" name="do" value="comment" />
            <textarea name="content" rows="2" required class="w-full px-3 py-2 border rounded-md border-slate-300" placeholder="<%= t('client_portal.comment_placeholder') %>"></textarea>
            <button class="px-3 py-1.5 mt-1 text-sm font-semibold text-white bg-indigo-600 rounded-md"><%= t('client_portal.send') %></button>
          </form>
        </details>
        <details class="w-full text-sm sm:w-auto">
          <summary class="inline-block px-3 py-1.5 font-semibold border rounded-md cursor-pointer border-slate-300 hover:bg-slate-50"><%= t('client_portal.attach') %></summary>
          <form action="<%= task_path %>" method="post" enctype="multipart/form-data" class="mt-2">
            <input type="hidden" name="do" value="attach" />
            <input type="file" name="file" required class="block w-full text-sm" />
            <textarea name="content" rows="2" class="w-full px-3 py-2 mt-2 border rounded-md border-slate-300" placeholder="<%= t('client_portal.comment_placeholder') %>"></textarea>
            <button class="px-3 py-1.5 mt-1 text-sm font-semibold text-white bg-indigo-600 rounded-md"><%= t('client_portal.send') %></button>
          </form>
        </details>
      </div>
    <% end %>
  </div>
