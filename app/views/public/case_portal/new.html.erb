<section class="max-w-3xl mx-auto px-4 py-8">
  <nav class="text-sm text-slate-400 mb-4">
    <a href="<%= case_portal_path(@portal.slug) %>" class="hover:text-indigo-500">Inicio</a> › Abrir solicitud
  </nav>
  <h1 class="text-2xl font-bold mb-1">Abrir una solicitud</h1>
  <p class="text-slate-500 dark:text-slate-400 mb-6">Cuéntanos qué necesitas. Te daremos un número de folio para dar seguimiento.</p>

  <% if @error.present? %>
    <div class="mb-6 rounded-lg bg-rose-50 dark:bg-rose-500/10 text-rose-700 dark:text-rose-300 px-4 py-3 text-sm"><%= @error %></div>
  <% end %>

  <%= form_with url: case_portal_tickets_path(@portal.slug), method: :post, multipart: true, local: true, html: { class: 'space-y-6' } do %>

    <fieldset class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6">
      <legend class="px-2 text-sm font-semibold text-slate-500 dark:text-slate-400">Tus datos</legend>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1">Nombre <span class="text-rose-500">*</span></label>
          <input name="name" required value="<%= params[:name] %>" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 py-2 outline-none focus:ring-2 focus:ring-indigo-500" placeholder="María Gómez" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Correo electrónico</label>
          <input type="email" name="email" value="<%= params[:email] %>" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 py-2 outline-none focus:ring-2 focus:ring-indigo-500" placeholder="maria@empresa.com" />
        </div>
        <div class="sm:col-span-2">
          <label class="block text-sm font-medium mb-1">WhatsApp / teléfono</label>
          <input name="phone" value="<%= params[:phone] %>" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 py-2 outline-none focus:ring-2 focus:ring-indigo-500" placeholder="+57 300 123 4567" />
          <p class="text-xs text-slate-400 mt-1">Indica al menos un correo o un WhatsApp para poder avisarte.</p>
        </div>
      </div>
    </fieldset>

    <fieldset class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6">
      <legend class="px-2 text-sm font-semibold text-slate-500 dark:text-slate-400">Tu solicitud</legend>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1">Tipo de solicitud <span class="text-rose-500">*</span></label>
          <select name="case_type_id" required onchange="onTypeChange(this.value)" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 py-2 outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="" disabled <%= 'selected' if params[:case_type_id].blank? %>>Selecciona un tipo…</option>
            <% @case_types.each do |type| %>
              <option value="<%= type.id %>" <%= 'selected' if params[:case_type_id].to_s == type.id.to_s %>><%= type.name %></option>
            <% end %>
          </select>
          <% if @case_types.blank? %>
            <p class="text-xs text-rose-500 mt-1">No hay tipos de solicitud disponibles. Contacta al administrador.</p>
          <% end %>
        </div>

        <% @case_types.each do |type| %>
          <% fields = type.case_type_fields.ordered %>
          <% next if fields.blank? %>
          <div data-type-fields="<%= type.id %>" class="hidden rounded-xl bg-slate-50 dark:bg-slate-900/50 border border-dashed border-slate-300 dark:border-slate-600 p-4 space-y-4">
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">Información adicional</p>
            <% fields.each do |f| %>
              <div>
                <label class="block text-sm font-medium mb-1"><%= f.label %><% if f.required %> <span class="text-rose-500">*</span><% end %></label>
                <% if f.field_list? %>
                  <select name="custom[<%= f.key %>]" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 py-2 outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="">—</option>
                    <% Array(f.options).each do |opt| %><option value="<%= opt %>"><%= opt %></option><% end %>
                  </select>
                <% elsif f.field_checkbox? %>
                  <label class="inline-flex items-center gap-2 text-sm"><input type="checkbox" name="custom[<%= f.key %>]" value="true" class="rounded" /> Sí</label>
                <% else %>
                  <input type="<%= f.field_number? ? 'number' : (f.field_date? ? 'date' : 'text') %>" name="custom[<%= f.key %>]" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 py-2 outline-none focus:ring-2 focus:ring-indigo-500" />
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <div>
          <label class="block text-sm font-medium mb-1">Asunto <span class="text-rose-500">*</span></label>
          <input name="subject" required value="<%= params[:subject] %>" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 py-2 outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Resumen breve del problema" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Mensaje <span class="text-rose-500">*</span></label>
          <textarea name="message" required rows="5" class="w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-3 py-2 outline-none focus:ring-2 focus:ring-indigo-500" placeholder="Describe con detalle lo que ocurre…"><%= params[:message] %></textarea>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Adjuntos</label>
          <input type="file" name="attachments[]" multiple class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100" />
          <p class="text-xs text-slate-400 mt-1">Puedes adjuntar imágenes o documentos.</p>
        </div>
      </div>
    </fieldset>

    <div class="flex items-center justify-between">
      <a href="<%= case_portal_path(@portal.slug) %>" class="text-sm text-slate-500 hover:text-indigo-500">← Cancelar</a>
      <button type="submit" class="px-6 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium">Enviar solicitud</button>
    </div>
  <% end %>
</section>

<script>
  function onTypeChange(v) {
    document.querySelectorAll('[data-type-fields]').forEach(function (el) {
      el.classList.toggle('hidden', el.getAttribute('data-type-fields') !== v);
    });
  }
  document.addEventListener('DOMContentLoaded', function () {
    var sel = document.querySelector('select[name="case_type_id"]');
    if (sel && sel.value) onTypeChange(sel.value);
  });
</script>
